# Patterns naming a top-level directory are anchored with a leading slash.
# Unanchored, `data/` would also match `src/data/`, which is source and must
# be tracked. Cache and editor patterns are left unanchored deliberately, so
# they match at any depth.

# Virtual environment
/.venv/

# Third-party assets
/mujoco_menagerie/

# Data and outputs — large, regenerable
/data/
/outputs/
/logs/
/wandb/

# Generated scene (rebuild with build_scene.py)
/models/

# Python and tool caches — these may appear at any depth
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# Local agent tooling
/.claude/
/graphify-out/

# Editor — may appear at any depth
.vscode/
.idea/
